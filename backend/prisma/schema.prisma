datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(uuid())
  name           String
  email          String    @unique
  passwordHash   String
  storeName      String
  slug           String    @unique
  bio            String?
  avatarUrl      String?
  whatsappNumber String    @default("5511999999999")
  
  plan           String    @default("FREE") // "FREE" ou "PRO"
  primaryColor   String    @default("#2563EB") // Hex da cor primária
  
  links          Link[]
  products       Product[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Link {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title     String
  url       String
  icon      String   @default("globe")
  order     Int      @default(0)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  description   String?
  price         Float
  imageUrl      String?
  customMessage String?
  order         Int      @default(0)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
